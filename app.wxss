/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

/* 主题色 */
.primary-color {
  color: #4CAF50;
}

.primary-bg {
  background-color: #4CAF50;
}

/* 通用容器 */
.container {
  padding: 20rpx;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 按钮样式 */
.btn-primary {
  background-color: #4CAF50;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
  border: none;
}

.btn-primary:active {
  background-color: #45a049;
}

.btn-secondary {
  background-color: #ffffff;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
  border-radius: 12rpx;
  padding: 18rpx 38rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 输入框 */
.input-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.input-item:last-child {
  border-bottom: none;
}

.input-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666666;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.input-placeholder {
  color: #cccccc;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:active {
  background-color: #f8f8f8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 浮动按钮 */
.float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.4);
}

.float-btn text {
  font-size: 48rpx;
  color: #ffffff;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-green {
  background-color: #e8f5e9;
  color: #4CAF50;
}

.tag-orange {
  background-color: #fff3e0;
  color: #ff9800;
}

.tag-red {
  background-color: #ffebee;
  color: #f44336;
}

.tag-blue {
  background-color: #e3f2fd;
  color: #2196F3;
}

/* 状态颜色 */
.status-pending {
  color: #ff9800;
}

.status-done {
  color: #4CAF50;
}

.status-overdue {
  color: #f44336;
}