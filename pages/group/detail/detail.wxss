.container {
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 团队头部 */
.group-header {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.group-avatar {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4CAF50, #81C784);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #ffffff;
  font-weight: bold;
  margin-right: 24rpx;
}

.group-info {
  flex: 1;
}

.group-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.group-desc {
  font-size: 26rpx;
  color: #999999;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #999999;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
}

.invite-code {
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
}

.invite-code text:first-child {
  font-family: monospace;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  color: #4CAF50;
}

.copy-btn {
  font-size: 24rpx;
  color: #4CAF50;
  margin-left: 20rpx;
}

/* 标题区域 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.add-btn {
  font-size: 26rpx;
  color: #4CAF50;
}

/* 成员列表 */
.member-list {
  border-top: 1rpx solid #f0f0f0;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.member-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #4CAF50;
  font-weight: bold;
  margin-right: 20rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 4rpx;
}

.member-role {
  font-size: 24rpx;
  color: #999999;
}

.member-actions {
  display: flex;
}

.action-btn.delete {
  font-size: 24rpx;
  color: #f44336;
}

/* 实验列表 */
.experiment-list {
  border-top: 1rpx solid #f0f0f0;
}

.experiment-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.experiment-item:last-child {
  border-bottom: none;
}

.experiment-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 4rpx;
}

.experiment-meta {
  font-size: 24rpx;
  color: #999999;
}

.arrow {
  font-size: 32rpx;
  color: #cccccc;
}

/* 空状态 */
.empty-state.small {
  padding: 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 底部按钮 */
.bottom-area {
  padding: 40rpx 20rpx;
}

.btn-danger {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ffffff;
  color: #f44336;
  border: 2rpx solid #f44336;
  border-radius: 44rpx;
  font-size: 32rpx;
}