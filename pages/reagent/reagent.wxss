.library-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.library-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.library-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #4CAF50;
  background: rgba(76, 175, 80, 0.1);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
}

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.modal-content {
  background: #fff;
  width: 600rpx;
  border-radius: 16rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-input {
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
}

.modal-btns {
  display: flex;
  justify-content: space-between;
}

.modal-btn {
  width: 45%;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 8rpx;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #4CAF50;
  color: #fff;
}

.modal-btn.full-width {
  width: 100%;
  margin-top: 20rpx;
}

.invite-code-section {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.code-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.copy-hint {
  font-size: 20rpx;
  color: #999;
  margin-left: 10rpx;
}

.members-list {
  max-height: 400rpx;
}

.member-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.member-name {
  font-size: 28rpx;
  color: #333;
}

.search-bar {
  padding: 20rpx;
  background-color: #ffffff;
}

.search-input {
  background-color: #f5f5f5;
  padding: 20rpx 30rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.checkbox-wrapper {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}

.btn-export {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #4CAF50;
  padding: 10rpx 20rpx;
  background-color: rgba(76, 175, 80, 0.1);
  border-radius: 30rpx;
}

.export-icon {
  margin-right: 8rpx;
}

.strain-list {
  padding: 20rpx;
}

.strain-item {
  margin-bottom: 20rpx;
}

.strain-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.strain-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.strain-info {
  font-size: 26rpx;
}

.info-item {
  display: flex;
  padding: 8rpx 0;
}

.info-label {
  color: #999999;
  width: 160rpx;
}

.info-value {
  color: #666666;
  flex: 1;
}