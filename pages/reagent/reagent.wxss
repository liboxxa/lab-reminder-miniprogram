.search-bar {
  padding: 20rpx;
  background-color: #ffffff;
}

.search-input {
  background-color: #f5f5f5;
  padding: 20rpx 30rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.filter-tabs {
  display: flex;
  background-color: #ffffff;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab {
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab.active {
  color: #4CAF50;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #4CAF50;
  border-radius: 3rpx;
}

.strain-list {
  padding: 20rpx;
}

.strain-item {
  margin-bottom: 20rpx;
}

.strain-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.strain-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.strain-info {
  font-size: 26rpx;
}

.info-item {
  display: flex;
  padding: 8rpx 0;
}

.info-label {
  color: #999999;
  width: 160rpx;
}

.info-value {
  color: #666666;
  flex: 1;
}