<view class="login-container">
  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo">🧪</view>
    <view class="app-name">实验提醒助手</view>
    <view class="app-desc">让实验管理更简单</view>
  </view>

  <!-- 登录按钮区域 -->
  <view class="login-section">
    <button class="login-btn wechat-btn" bindtap="wechatLogin">
      <text class="btn-icon">微信</text>
      <text>微信一键登录</text>
    </button>
    
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">或</text>
      <view class="divider-line"></view>
    </view>

    <!-- 手机号登录（可选） -->
    <view class="phone-login-form" wx:if="{{showPhoneLogin}}">
      <view class="input-group">
        <input 
          class="input-field" 
          type="number" 
          maxlength="11"
          placeholder="请输入手机号" 
          bindinput="onPhoneInput"
          value="{{phone}}"
        />
      </view>
      <view class="input-group">
        <input 
          class="input-field code-input" 
          type="number" 
          maxlength="6"
          placeholder="请输入验证码" 
          bindinput="onCodeInput"
          value="{{code}}"
        />
        <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </view>
      </view>
      <button class="login-btn phone-btn" bindtap="phoneLogin">登录</button>
    </view>

    <view class="switch-login" bindtap="togglePhoneLogin">
      {{showPhoneLogin ? '使用微信登录' : '使用手机号登录'}}
    </view>
  </view>

  <!-- 协议 -->
  <view class="agreement">
    <view class="checkbox-wrapper" bindtap="toggleAgreement">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}">✓</text>
      </view>
    </view>
    <text class="agreement-text">
      我已阅读并同意
      <text class="link" bindtap="showUserAgreement">《用户协议》</text>
      和
      <text class="link" bindtap="showPrivacyPolicy">《隐私政策》</text>
    </text>
  </view>
</view>