<view class="container">
  <!-- 基本信息 -->
  <view class="card">
    <view class="strain-header">
      <view class="strain-name">{{strainInfo.name}}</view>
      <view class="tag {{strainInfo.isShared ? 'tag-blue' : 'tag-green'}}">
        {{strainInfo.isShared ? '共享' : '私有'}}
      </view>
    </view>

    <view class="info-section">
      <view class="info-row">
        <text class="info-label">描述</text>
        <text class="info-value">{{strainInfo.description || '暂无描述'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">来源</text>
        <text class="info-value">{{strainInfo.source || '未填写'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">保存位置</text>
        <text class="info-value">{{strainInfo.storageLocation || '未填写'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">培养温度</text>
        <text class="info-value">{{strainInfo.conditions.temperature ? strainInfo.conditions.temperature + '°C' : '未填写'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">培养基</text>
        <text class="info-value">{{strainInfo.conditions.medium || '未填写'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{strainInfo.createdAt}}</text>
      </view>
    </view>
  </view>

  <!-- 操作记录 -->
  <view class="card">
    <view class="section-header">
      <view class="section-title">操作记录</view>
      <view class="add-btn" bindtap="addLog">+ 添加记录</view>
    </view>

    <view wx:if="{{operationLogs.length > 0}}" class="log-list">
      <view class="log-item" wx:for="{{operationLogs}}" wx:key="id">
        <view class="log-time">{{item.operatedAt}}</view>
        <view class="log-content">
          <view class="log-title">{{item.content}}</view>
          <view class="log-images" wx:if="{{item.images && item.images.length > 0}}">
            <image 
              wx:for="{{item.images}}" 
              wx:for-item="img" 
              wx:key="*this" 
              src="{{img}}" 
              mode="aspectFill"
              class="log-image"
              bindtap="previewImage"
              data-urls="{{item.images}}"
              data-current="{{img}}"
            />
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state small">
      <text class="empty-text">暂无操作记录</text>
    </view>
  </view>

  <!-- 关联实验 -->
  <view class="card">
    <view class="section-header">
      <view class="section-title">关联实验</view>
    </view>

    <view wx:if="{{relatedExperiments.length > 0}}">
      <view 
        class="experiment-item" 
        wx:for="{{relatedExperiments}}" 
        wx:key="id"
        bindtap="goExperiment"
        data-id="{{item.id}}"
      >
        <view class="experiment-info">
          <view class="experiment-name">{{item.name}}</view>
          <view class="experiment-date">{{item.startDate}}</view>
        </view>
        <view class="tag {{item.status === 'ongoing' ? 'tag-green' : 'tag-blue'}}">
          {{item.status === 'ongoing' ? '进行中' : '已完成'}}
        </view>
      </view>
    </view>

    <view wx:else class="empty-state small">
      <text class="empty-text">暂无关联实验</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-btn" bindtap="editStrain">
      <text class="bar-icon">✏️</text>
      <text>编辑</text>
    </view>
    <view class="bar-btn" bindtap="createExperiment">
      <text class="bar-icon">🧪</text>
      <text>创建实验</text>
    </view>
    <view class="bar-btn danger" bindtap="deleteStrain">
      <text class="bar-icon">🗑️</text>
      <text>删除</text>
    </view>
  </view>
</view>

<!-- 添加记录弹窗 -->
<view class="modal-mask" wx:if="{{showLogModal}}" bindtap="closeLogModal"></view>
<view class="modal-content" wx:if="{{showLogModal}}">
  <view class="modal-header">
    <text class="modal-title">添加操作记录</text>
    <text class="modal-close" bindtap="closeLogModal">×</text>
  </view>
  <view class="modal-body">
    <textarea 
      class="log-textarea" 
      placeholder="记录操作内容..."
      bindinput="onLogInput"
      value="{{newLog.content}}"
    />
    <view class="image-uploader">
      <view class="upload-list">
        <view class="upload-item" wx:for="{{newLog.images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="upload-image" />
          <view class="remove-btn" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
        <view class="upload-btn" bindtap="chooseImage" wx:if="{{newLog.images.length < 9}}">
          <text>+</text>
          <text class="upload-text">添加图片</text>
        </view>
      </view>
    </view>
  </view>
  <view class="modal-footer">
    <button class="modal-btn cancel" bindtap="closeLogModal">取消</button>
    <button class="modal-btn confirm" bindtap="submitLog">保存</button>
  </view>
</view>