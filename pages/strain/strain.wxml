<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索菌种名称/编号" bindinput="onSearch" />
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab {{currentTab === 'mine' ? 'active' : ''}}" bindtap="switchTab" data-tab="mine">我的</view>
    <view class="tab {{currentTab === 'shared' ? 'active' : ''}}" bindtap="switchTab" data-tab="shared">共享的</view>
  </view>

  <!-- 菌种列表 -->
  <view class="strain-list">
    <view wx:if="{{strainList.length > 0}}">
      <view class="strain-item card" wx:for="{{strainList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="strain-header">
          <view class="strain-name">{{item.name}}</view>
          <view class="tag {{item.isShared ? 'tag-blue' : 'tag-green'}}">
            {{item.isShared ? '共享' : '私有'}}
          </view>
        </view>
        <view class="strain-info">
          <view class="info-item">
            <text class="info-label">来源：</text>
            <text class="info-value">{{item.source || '未填写'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">保存位置：</text>
            <text class="info-value">{{item.storageLocation || '未填写'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">创建时间：</text>
            <text class="info-value">{{item.createdAt}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state">
      <text class="empty-text">暂无菌种档案</text>
      <view class="btn-primary" style="margin-top: 30rpx;" bindtap="goAdd">添加菌种</view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="float-btn" bindtap="goAdd">
    <text>+</text>
  </view>
</view>