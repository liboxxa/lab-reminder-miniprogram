.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.add-btn {
  font-size: 28rpx;
  color: #4CAF50;
}

/* 模板卡片 */
.template-list {
  display: flex;
  flex-direction: column;
}

.template-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.template-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.template-type {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.template-info {
  display: flex;
  margin-bottom: 16rpx;
}

.info-item {
  font-size: 24rpx;
  color: #666666;
  margin-right: 30rpx;
}

.template-steps {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx;
}

.step-preview {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.step-day {
  width: 60rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background-color: #e8f5e9;
  color: #4CAF50;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.step-content {
  font-size: 26rpx;
  color: #666666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.step-more {
  font-size: 24rpx;
  color: #999999;
  padding: 8rpx 0;
  text-align: center;
}

.template-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  margin-left: 20rpx;
}

.action-btn.edit {
  color: #4CAF50;
}

.action-btn.delete {
  color: #f44336;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 30rpx;
  text-align: center;
}

.btn-primary {
  background-color: #4CAF50;
  color: #ffffff;
  border-radius: 44rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
  border: none;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title-area {
  display: flex;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
}

.detail-type {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.detail-section {
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.step-list {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx;
}

.step-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #e0e0e0;
}

.step-item:last-child {
  border-bottom: none;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background-color: #4CAF50;
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-info {
  flex: 1;
}

.step-time {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.step-clock {
  font-size: 24rpx;
  color: #999999;
  font-weight: normal;
  margin-left: 16rpx;
}

.step-desc {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.step-tags {
  display: flex;
}

.mini-tag {
  font-size: 22rpx;
  color: #ff9800;
  background-color: #fff8e1;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.modal-footer {
  padding: 20rpx 30rpx 40rpx;
}

.modal-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.modal-btn.confirm {
  background-color: #4CAF50;
  color: #ffffff;
}
.type-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin: 16rpx 0;
}