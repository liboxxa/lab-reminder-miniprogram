<view class="container">
  <!-- 实验基本信息 -->
  <view class="card">
    <view class="exp-header">
      <view class="exp-name">{{experimentInfo.name}}</view>
      <view class="tag {{experimentInfo.status === 'ongoing' ? 'tag-green' : 'tag-blue'}}">
        {{experimentInfo.status === 'ongoing' ? '进行中' : '已完成'}}
      </view>
    </view>
    <view class="exp-type">{{experimentInfo.type}}</view>
    
    <view class="exp-stats">
      <view class="stat-item">
        <view class="stat-num">{{experimentInfo.currentDay}}</view>
        <view class="stat-label">当前天数</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{experimentInfo.totalReminders}}</view>
        <view class="stat-label">总提醒数</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{experimentInfo.completedCount}}</view>
        <view class="stat-label">已完成</view>
      </view>
    </view>

    <view class="exp-info">
      <view class="info-row">
        <text class="info-label">开始日期</text>
        <text class="info-value">{{experimentInfo.startDate}}</text>
      </view>
      <view class="info-row" wx:if="{{experimentInfo.strainNames}}">
        <text class="info-label">使用菌种</text>
        <text class="info-value">{{experimentInfo.strainNames}}</text>
      </view>
      <view class="info-row" wx:if="{{experimentInfo.description}}">
        <text class="info-label">实验描述</text>
        <text class="info-value">{{experimentInfo.description}}</text>
      </view>
    </view>
  </view>

  <!-- 时间线 -->
  <view class="card">
    <view class="section-header">
      <view class="section-title">实验时间线</view>
      <view class="add-btn" bindtap="addLog">+ 添加记录</view>
    </view>

    <view class="timeline" wx:if="{{timelineList.length > 0}}">
      <view 
        class="timeline-item {{item.status}}" 
        wx:for="{{timelineList}}" 
        wx:key="id"
      >
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-header">
            <view class="timeline-day">
              {{item.dayType === 'hour' ? '第' + item.dayNum + '小时' : '第' + item.dayNum + '天'}}
            </view>
            <view class="timeline-date">{{item.date}}</view>
          </view>
          <view class="timeline-title">{{item.content}}</view>
          
         <!-- 操作记录 -->
      <view class="timeline-logs" wx:if="{{item.logs && item.logs.length > 0}}">
        <view class="log-entry" wx:for="{{item.logs}}" wx:for-item="log" wx:key="id">
         <!-- 新增：头部显示 操作人 + 时间 -->
          <view class="log-header">
            <text class="log-operator">{{log.operatorName || '未知成员'}}</text>
           <text class="log-time">{{log.operatedAt}}</text>
          </view>

          <!-- 日志内容 -->
          <view class="log-content-area">
            <view class="log-text">{{log.content}}</view>
      
            <!-- 图片列表 -->
           <view class="log-images" wx:if="{{log.images && log.images.length > 0}}">
             <image 
               wx:for="{{log.images}}" 
                wx:for-item="img" 
                wx:key="*this"
                src="{{img}}" 
                mode="aspectFill"
               class="log-image"
               bindtap="previewImage"
               data-urls="{{log.images}}"
               data-current="{{img}}"
              />
            </view>
         </view>
        </view>
         </view>

          <!-- 操作按钮 -->
          <view class="timeline-actions" wx:if="{{item.status === 'current' || item.status === 'pending'}}">
            <button 
              class="action-btn complete" 
              size="mini" 
              bindtap="completeTask"
              data-item="{{item}}"
            >
              {{item.needPhoto ? '完成并拍照' : '标记完成'}}
            </button>
            <button 
              class="action-btn skip" 
              size="mini" 
              bindtap="skipTask"
              data-item="{{item}}"
            >跳过</button>
          </view>

          <view class="timeline-status-tag" wx:if="{{item.status === 'done'}}">
            <text class="done-tag">✓ 已完成</text>
          </view>
          <view class="timeline-status-tag" wx:if="{{item.status === 'skipped'}}">
            <text class="skipped-tag">已跳过</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state small">
      <text class="empty-text">暂无提醒计划</text>
    </view>
  </view>

  <!-- 关联菌种 -->
  <view class="card" wx:if="{{relatedStrains.length > 0}}">
    <view class="section-title">关联菌种</view>
    <view class="strain-list">
      <view 
        class="strain-item" 
        wx:for="{{relatedStrains}}" 
        wx:key="id"
        bindtap="goStrainDetail"
        data-id="{{item.id}}"
      >
        <view class="strain-name">{{item.name}}</view>
        <view class="arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-btn" bindtap="editExperiment">
      <text class="bar-icon">✏️</text>
      <text>编辑</text>
    </view>
    <view class="bar-btn" bindtap="toggleStatus">
      <text class="bar-icon">{{experimentInfo.status === 'ongoing' ? '✅' : '🔄'}}</text>
      <text>{{experimentInfo.status === 'ongoing' ? '完成实验' : '重新开始'}}</text>
    </view>
    <view class="bar-btn danger" bindtap="deleteExperiment">
      <text class="bar-icon">🗑️</text>
      <text>删除</text>
    </view>
  </view>
</view>

<!-- 添加记录弹窗 -->
<view class="modal-mask" wx:if="{{showLogModal}}" bindtap="closeLogModal"></view>
<view class="modal-content" wx:if="{{showLogModal}}">
  <view class="modal-header">
    <text class="modal-title">添加操作记录</text>
    <text class="modal-close" bindtap="closeLogModal">×</text>
  </view>
  <view class="modal-body">
    <view class="form-item">
      <view class="form-label">选择时间点</view>
      <picker 
        range="{{reminderOptions}}" 
        range-key="label" 
        value="{{selectedReminderIndex}}"
        bindchange="onReminderSelect"
      >
        <view class="picker-value">{{reminderOptions[selectedReminderIndex].label || '请选择'}} ›</view>
      </picker>
    </view>
    <view class="form-item">
      <view class="form-label">操作内容</view>
      <textarea 
        class="form-textarea" 
        placeholder="记录操作内容..."
        bindinput="onLogInput"
        value="{{newLog.content}}"
      />
    </view>
    <view class="image-uploader">
      <view class="form-label">添加图片</view>
      <view class="upload-list">
        <view class="upload-item" wx:for="{{newLog.images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="upload-image" />
          <view class="remove-btn" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
        <view class="upload-btn" bindtap="chooseImage" wx:if="{{newLog.images.length < 9}}">
          <text>+</text>
          <text class="upload-text">添加</text>
        </view>
      </view>
    </view>
  </view>
  <view class="modal-footer">
    <button class="modal-btn cancel" bindtap="closeLogModal">取消</button>
    <button class="modal-btn confirm" bindtap="submitLog">保存</button>
  </view>
</view>