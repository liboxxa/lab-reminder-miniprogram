.container {
  padding: 20rpx;
  padding-bottom: 160rpx;
}

/* 实验头部 */
.exp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.exp-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.exp-type {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

/* 统计数据 */
.exp-stats {
  display: flex;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #e0e0e0;
}

.stat-item:last-child {
  border-right: none;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #4CAF50;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

/* 信息行 */
.exp-info {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.info-row {
  display: flex;
  padding: 12rpx 0;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999999;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

/* 标题区域 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.add-btn {
  font-size: 26rpx;
  color: #4CAF50;
}

/* 时间线 */
.timeline {
  position: relative;
  padding-left: 30rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 20rpx;
  bottom: 20rpx;
  width: 4rpx;
  background-color: #e0e0e0;
}

.timeline-item {
  position: relative;
  padding-bottom: 40rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -26rpx;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  border: 4rpx solid #ffffff;
  z-index: 1;
}

.timeline-item.done .timeline-dot {
  background-color: #4CAF50;
}

.timeline-item.current .timeline-dot {
  background-color: #ff9800;
  box-shadow: 0 0 0 6rpx rgba(255, 152, 0, 0.2);
}

.timeline-item.pending .timeline-dot {
  background-color: #e0e0e0;
}

.timeline-item.skipped .timeline-dot {
  background-color: #9e9e9e;
}

.timeline-content {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-left: 20rpx;
}

.timeline-item.current .timeline-content {
  background-color: #fff8e1;
  border: 1rpx solid #ffe082;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.timeline-day {
  font-size: 28rpx;
  font-weight: bold;
  color: #4CAF50;
}

.timeline-item.current .timeline-day {
  color: #ff9800;
}

.timeline-date {
  font-size: 24rpx;
  color: #999999;
}

.timeline-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

/* 操作记录 */
.timeline-logs {
  border-top: 1rpx dashed #e0e0e0;
  padding-top: 16rpx;
  margin-top: 16rpx;
}

.log-entry {
  margin-bottom: 16rpx;
}

.log-entry:last-child {
  margin-bottom: 0;
}

.log-text {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.log-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.log-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.log-time {
  font-size: 22rpx;
  color: #999999;
}

/* 操作按钮 */
.timeline-actions {
  display: flex;
  margin-top: 16rpx;
}

.action-btn {
  margin-right: 16rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.action-btn.complete {
  background-color: #4CAF50;
  color: #ffffff;
}

.action-btn.skip {
  background-color: #f5f5f5;
  color: #666666;
}

/* 状态标签 */
.timeline-status-tag {
  margin-top: 12rpx;
}

.done-tag {
  font-size: 24rpx;
  color: #4CAF50;
}

.skipped-tag {
  font-size: 24rpx;
  color: #9e9e9e;
}

/* 菌种列表 */
.strain-list {
  border-top: 1rpx solid #f0f0f0;
}

.strain-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.strain-item:last-child {
  border-bottom: none;
}

.strain-name {
  font-size: 28rpx;
  color: #333333;
}

.arrow {
  font-size: 32rpx;
  color: #cccccc;
}

/* 空状态 */
.empty-state.small {
  padding: 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  padding: 20rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
}

.bar-btn.danger {
  color: #f44336;
}

.bar-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 图片上传 */
.image-uploader {
  margin-top: 20rpx;
}

.upload-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.upload-item {
  position: relative;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.upload-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.remove-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #f44336;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
}

.upload-btn text:first-child {
  font-size: 48rpx;
}

.upload-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx 40rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin: 0 10rpx;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666666;
}

.modal-btn.confirm {
  background-color: #4CAF50;
  color: #ffffff;
}