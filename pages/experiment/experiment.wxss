.container {
  padding-bottom: 120rpx;
}

.filter-tabs {
  display: flex;
  background-color: #ffffff;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab {
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab.active {
  color: #4CAF50;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #4CAF50;
  border-radius: 3rpx;
}

.experiment-list {
  padding: 20rpx;
}

.experiment-item {
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.experiment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.experiment-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.experiment-type {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.experiment-info {
  padding: 16rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.info-row {
  display: flex;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.info-label {
  color: #999999;
  width: 160rpx;
}

.info-value {
  color: #666666;
  flex: 1;
}

.primary-color {
  color: #4CAF50;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.tag-green {
  background-color: #e8f5e9;
  color: #4CAF50;
}

.tag-blue {
  background-color: #e3f2fd;
  color: #2196F3;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
.experiment-share {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}
.btn-primary {
  background-color: #4CAF50;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
  border: none;
}

/* 浮动按钮 */
.float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.4);
}

.float-btn text {
  font-size: 48rpx;
  color: #ffffff;
}