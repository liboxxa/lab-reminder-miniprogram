.container {
  padding: 20rpx;
  padding-bottom: 160rpx;
}

/* 步骤指示器 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  background-color: #ffffff;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.step.active .step-num {
  background-color: #4CAF50;
  color: #ffffff;
}

.step-text {
  font-size: 22rpx;
  color: #999999;
}

.step.active .step-text {
  color: #4CAF50;
}

.step-line {
  width: 60rpx;
  height: 4rpx;
  background-color: #e0e0e0;
  margin: 0 10rpx;
  margin-bottom: 30rpx;
}

.step-line.active {
  background-color: #4CAF50;
}

/* 表单样式 */
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.form-label.required::before {
  content: '*';
  color: #f44336;
  margin-right: 8rpx;
}

.form-item.row .form-label {
  margin-bottom: 0;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 类型标签 */
.type-tags {
  display: flex;
  flex-wrap: wrap;
}

.type-tag {
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.type-tag.active {
  background-color: #e8f5e9;
  color: #4CAF50;
  border: 1rpx solid #4CAF50;
}

/* 模板列表 */
.template-list {
  display: flex;
  flex-direction: column;
}

.template-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  position: relative;
  border: 2rpx solid transparent;
}

.template-item.active {
  background-color: #e8f5e9;
  border-color: #4CAF50;
}

.template-item.add {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  color: #4CAF50;
  border: 2rpx dashed #4CAF50;
  background-color: #ffffff;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.template-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.template-desc {
  font-size: 24rpx;
  color: #999999;
}

.template-check {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  background-color: #4CAF50;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 菌种选择 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.add-btn {
  font-size: 26rpx;
  color: #4CAF50;
}

.strain-select-list {
  border-top: 1rpx solid #f0f0f0;
}

.strain-select-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.strain-select-item:last-child {
  border-bottom: none;
}

.strain-checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #cccccc;
  border-radius: 8rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #ffffff;
}

.strain-select-item.selected .strain-checkbox {
  background-color: #4CAF50;
  border-color: #4CAF50;
}

.strain-info {
  flex: 1;
}

.strain-name {
  font-size: 28rpx;
  color: #333333;
}

.strain-meta {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.selected-strains {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.selected-tag {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #e8f5e9;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #4CAF50;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.remove-tag {
  margin-left: 12rpx;
  font-size: 28rpx;
}

/* 提醒计划 */
.reminder-list {
  border-top: 1rpx solid #f0f0f0;
}

.reminder-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.reminder-day {
  font-size: 30rpx;
  font-weight: bold;
  color: #4CAF50;
}

.reminder-actions {
  display: flex;
}

.edit-btn {
  font-size: 24rpx;
  color: #4CAF50;
  margin-right: 20rpx;
}

.delete-btn {
  font-size: 24rpx;
  color: #f44336;
}

.reminder-content {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.reminder-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
}

.reminder-time {
  margin-right: 20rpx;
}

.reminder-photo {
  color: #ff9800;
}

/* 空状态 */
.empty-state.small {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-hint {
  font-size: 24rpx;
  color: #cccccc;
  margin-top: 8rpx;
}

/* 底部按钮 */
.bottom-btns {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 40rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.bottom-btns button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin: 0 10rpx;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #666666;
}

.btn-primary {
  background-color: #4CAF50;
  color: #ffffff;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx 40rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin: 0 10rpx;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666666;
}

.modal-btn.confirm {
  background-color: #4CAF50;
  color: #ffffff;
}