/* 整体容器 */
.container {
  padding: 20rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 步骤指示器 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  background-color: #ffffff;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width:50rpx;          /* 宽度放大一点 */
  height: 50rpx;         /* 高度和宽度一致，保持正圆 */
  border-radius: 50%;    /* 圆形 */
  background-color: #ffffff;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;      /* 字体稍微小一点 */
  margin-bottom: 8rpx;
  white-space: nowrap;   /* 关键：不换行 */
}

.step.active .step-num {
  background-color: #4CAF50;
  color: #ffffff;
}

.step-text {
  font-size: 24rpx;
  color: #999999;
}

.step.active .step-text {
  color: #4CAF50;
}

.step-line {
  width: 60rpx;
  height: 4rpx;
  background-color: #e0e0e0;
  margin: 0 10rpx;
  margin-bottom: 30rpx;
  border-radius: 2rpx;
}

.step-line.active {
  background-color: #4CAF50;
}

/* 步骤内容区域 */
.step-content {
  margin-bottom: 20rpx;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 20rpx 12rpx rgba(0, 0, 0, 0.03);
}

/* 表单项 */
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.form-label.required::before {
  content: '*';
  color: #f44336;
  margin-right: 8rpx;
}

.form-item.row .form-label {
  margin-bottom: 0;
}

/* 输入框 / 文本域 */
.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 类型推荐标签 */
.type-suggestions {
  margin-top: 12rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
  display: block;
}

.type-tags {
  display: flex;
  flex-wrap: wrap;
}

.type-tag {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
}

.type-tag.active {
  background-color: #e8f5e9;
  color: #4CAF50;
  border: 1rpx solid #4CAF50;
}

/* 模板列表 */
.template-list {
  display: flex;
  flex-direction: column;
}

.template-item {
  position: relative;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.template-item.active {
  border-color: #4CAF50;
  background-color: #e8f5e9;
}

.template-name {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.template-desc {
  font-size: 24rpx;
  color: #999999;
}

.template-check {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #4CAF50;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.empty-state.small {
  padding: 40rpx 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.empty-hint {
  font-size: 24rpx;
  color: #cccccc;
  margin-top: 8rpx;
}

/* 实验步骤卡片 */
.step-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.step-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.step-num {
  font-size:20rpx;
  color: #4CAF50;
  font-weight: bold;
}

.step-actions {
  display: flex;
}

.action-btn {
  font-size: 24rpx;
  color: #4CAF50;
  margin-left: 20rpx;
}

.action-btn.delete {
  color: #f44336;
}

.step-body {
  padding-left: 4rpx;
}

.step-name {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 6rpx;
}

.step-library {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 4rpx;
}

.step-time {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 4rpx;
}

.step-clock {
  font-size: 24rpx;
  color: #999999;
  margin-left: 16rpx;
}

.step-reagent {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* 底部按钮区域 */
.bottom-btns {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 40rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.bottom-btns button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin: 0 10rpx;
}

.btn-primary {
  background-color: #4CAF50;
  color: #ffffff;
  border: none;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #666666;
  border: none;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

/* 弹窗主体 */
.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
}


.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 20rpx 30rpx;
  overflow-y: auto;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx 30rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin: 0 10rpx;
  border: none;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666666;
}

.modal-btn.confirm {
  background-color: #4CAF50;
  color: #ffffff;
}

