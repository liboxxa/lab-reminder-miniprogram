<view class="container">
  <!-- 步骤指示器 -->
  <view class="steps">
    <view class="step {{currentStep >= 1 ? 'active' : ''}}">
      <view class="step-num">步骤1</view>
      <text class="step-text">基本信息</text>
    </view>
    <view class="step-line {{currentStep >= 2 ? 'active' : ''}}"></view>
    <view class="step {{currentStep >= 2 ? 'active' : ''}}">
      <view class="step-num">步骤2</view>
      <text class="step-text">实验步骤</text>
    </view>
  </view>

  <!-- 步骤1：基本信息 -->
  <view class="step-content" wx:if="{{currentStep === 1}}">
    <view class="card">
      <!-- 实验名称 -->
      <view class="form-item">
        <view class="form-label required">实验名称</view>
        <input
          class="form-input"
          placeholder="如：涂布培养-001"
          bindinput="onInput"
          data-field="name"
          value="{{formData.name}}"
        />
      </view>

      <!-- 实验类型（自定义） -->
      <view class="form-item">
        <view class="form-label required">实验类型</view>
        <input
          class="form-input"
          placeholder="如：涂布培养、甲醇诱导、自定义流程"
          bindinput="onInput"
          data-field="type"
          value="{{formData.type}}"
        />
        <view class="type-suggestions" wx:if="{{typeOptions.length > 0}}">
          <text class="hint-text">常用类型：</text>
          <view class="type-tags">
            <view
              class="type-tag {{formData.type === item ? 'active' : ''}}"
              wx:for="{{typeOptions}}"
              wx:key="*this"
              data-type="{{item}}"
              bindtap="selectTypeFromTag"
            >
              {{item}}
            </view>
          </view>
        </view>
      </view>

      <!-- 选择模板（可选） -->
      <view class="form-item">
        <view class="form-label">选择模板（可选）</view>
        <view wx:if="{{filteredTemplates.length > 0}}" class="template-list">
          <view
            class="template-item {{formData.templateId === item.id ? 'active' : ''}}"
            wx:for="{{filteredTemplates}}"
            wx:key="id"
            data-template="{{item}}"
            bindtap="selectTemplate"
          >
            <view class="template-name">{{item.name}}</view>
            <view class="template-desc">
              共 {{item.stepsCount}} 步 · 类型：{{item.type || '未分类'}}
            </view>
            <view
              class="template-check"
              wx:if="{{formData.templateId === item.id}}"
            >✓</view>
          </view>
        </view>
        <view wx:else class="empty-state small">
          <text class="empty-text">当前类型下暂无模板</text>
          <text class="empty-hint">可以直接在下一步自定义步骤</text>
        </view>
      </view>

      <!-- 开始日期 -->
      <view class="form-item">
        <view class="form-label required">开始日期</view>
        <picker mode="date" value="{{formData.startDate}}" bindchange="onDateChange">
          <view class="picker-value">
            {{formData.startDate || '请选择日期'}} ›
          </view>
        </picker>
      </view>

      <!-- 实验描述 -->
      <view class="form-item">
        <view class="form-label">实验描述</view>
        <textarea
          class="form-textarea"
          placeholder="实验目的、备注等（可选）"
          bindinput="onInput"
          data-field="description"
          value="{{formData.description}}"
        />
      </view>
    </view>

    <!-- 共享给团队 -->
    <view class="card">
      <view class="form-item row">
        <view class="form-label">共享给团队</view>
        <switch
          checked="{{formData.isShared}}"
          bindchange="onShareChange"
          color="#4CAF50"
        />
      </view>

      <view class="form-item" wx:if="{{formData.isShared}}">
        <view class="form-label">选择团队</view>
        <picker
          range="{{groupList}}"
          range-key="name"
          value="{{selectedGroupIndex}}"
          bindchange="onGroupChange"
        >
          <view class="picker-value">
            {{groupList.length ? groupList[selectedGroupIndex].name : '暂无团队'}} ›
          </view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 步骤2：实验步骤 -->
  <view class="step-content" wx:if="{{currentStep === 2}}">
    <!-- 步骤列表 -->
    <view class="card">
      <view class="section-header">
        <view class="section-title">实验步骤</view>
        <view class="add-btn" bindtap="openStepModal">+ 添加步骤</view>
      </view>

      <view wx:if="{{steps.length > 0}}">
        <view class="step-card" wx:for="{{steps}}" wx:key="index">
          <view class="step-header">
            <view class="step-num">步骤 {{index + 1}}</view>
            <view class="step-actions">
              <text class="action-btn" data-index="{{index}}" catchtap="editStep">编辑</text>
              <text class="action-btn delete" data-index="{{index}}" catchtap="deleteStep">删除</text>
            </view>
          </view>
          <view class="step-body">
            <view class="step-name">{{item.name}}</view>
            <view class="step-time">
              {{item.dayType === 'day'
                  ? '第 ' + item.dayNum + ' 天'
                  : '第 ' + item.dayNum + ' 小时'}}
              <text wx:if="{{item.dayType === 'day' && item.time}}" class="step-clock">
                {{item.time}}
              </text>
            </view>
            <view class="step-reagent" wx:if="{{item.reagentText}}">
              试剂及用量：{{item.reagentText}}
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-state small">
        <text class="empty-text">还没有添加步骤</text>
        <text class="empty-hint">建议至少添加一步实验操作</text>
      </view>
    </view>

    <!-- 保存为模板 -->
    <view class="card">
      <view class="form-item row">
        <view class="form-label">将本次实验步骤保存为模板</view>
        <switch
          checked="{{saveAsTemplate}}"
          bindchange="onSaveAsTemplateChange"
          color="#4CAF50"
        />
      </view>
      <view class="form-item" wx:if="{{saveAsTemplate}}">
        <view class="form-label required">模板名称</view>
        <input
          class="form-input"
          placeholder="如：涂布培养标准流程"
          bindinput="onTemplateNameInput"
          value="{{templateName}}"
        />
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-btns">
    <button class="btn-secondary" wx:if="{{currentStep > 1}}" bindtap="prevStep">上一步</button>
    <button class="btn-primary" wx:if="{{currentStep < 2}}" bindtap="nextStep">下一步</button>
    <button class="btn-primary" wx:if="{{currentStep === 2}}" bindtap="submit">创建实验</button>
  </view>
</view>

<!-- 步骤编辑弹窗 -->
<view class="modal-mask" wx:if="{{showStepModal}}" bindtap="closeStepModal"></view>
<view class="modal-content" wx:if="{{showStepModal}}">
  <view class="modal-header">
    <text class="modal-title">{{editingStepIndex >= 0 ? '编辑步骤' : '添加步骤'}}</text>
    <text class="modal-close" bindtap="closeStepModal">×</text>
  </view>
  <view class="modal-body">
    <!-- 步骤名称 -->
    <view class="form-item">
      <view class="form-label required">步骤名称</view>
      <input
        class="form-input"
        placeholder="如：涂布平板、加甲醇、收样"
        bindinput="onStepInput"
        data-field="name"
        value="{{editingStep.name}}"
      />
    </view>

    <!-- 时间类型 -->
    <view class="form-item">
      <view class="form-label">时间类型</view>
      <view class="type-tags">
        <view
          class="type-tag {{editingStep.dayType === 'day' ? 'active' : ''}}"
          data-type="day"
          bindtap="setStepDayType"
        >按天</view>
        <view
          class="type-tag {{editingStep.dayType === 'hour' ? 'active' : ''}}"
          data-type="hour"
          bindtap="setStepDayType"
        >按小时</view>
      </view>
    </view>

    <!-- 第几天/小时 -->
    <view class="form-item">
      <view class="form-label required">
        {{editingStep.dayType === 'day' ? '第几天' : '第几小时'}}
      </view>
      <input
        class="form-input"
        type="number"
        placeholder="如：0（当天）、3（第3天）、24（24小时后）"
        bindinput="onStepInput"
        data-field="dayNum"
        value="{{editingStep.dayNum}}"
      />
    </view>

    <!-- 提醒时间（仅按天时可选） -->
    <view class="form-item" wx:if="{{editingStep.dayType === 'day'}}">
      <view class="form-label">提醒时间</view>
      <picker mode="time" value="{{editingStep.time}}" bindchange="onStepTimeChange">
        <view class="picker-value">{{editingStep.time || '默认 09:00'}} ›</view>
      </picker>
    </view>

    <!-- 使用试剂和用量（文本） -->
    <view class="form-item">
      <view class="form-label">使用试剂和用量（文本）</view>
      <textarea
        class="form-textarea"
        placeholder="如：LB平板 1块；甲醇 1 mL；IPTG 1mM 1 mL"
        bindinput="onStepInput"
        data-field="reagentText"
        value="{{editingStep.reagentText}}"
      />
    </view>

    <!-- 从试剂库选择 -->
    <view class="form-item row">
      <view class="form-label">从试剂库选择</view>
      <view class="btn-secondary small" catchtap="openReagentSelector">
        选择试剂
      </view>
    </view>
  </view>
  <view class="modal-footer">
    <button class="modal-btn cancel" bindtap="closeStepModal">取消</button>
    <button class="modal-btn confirm" bindtap="saveStep">保存</button>
  </view>
</view>

<!-- 试剂选择弹窗 -->
<view class="modal-mask" wx:if="{{showReagentSelector}}" bindtap="closeReagentSelector"></view>
<view class="modal-content reagent-selector" wx:if="{{showReagentSelector}}">
  <view class="modal-header">
    <text class="modal-title">选择试剂及用量</text>
    <text class="modal-close" bindtap="closeReagentSelector">×</text>
  </view>
  <view class="modal-body">
    <scroll-view scroll-y="true" style="max-height: 60vh;">
      <checkbox-group bindchange="onReagentCheckChange">
        <view
          class="reagent-row"
          wx:for="{{reagentList}}"
          wx:key="id"
          wx:for-item="r"
        >
          <view class="reagent-left">
            <checkbox
              value="{{r.id}}"
            />
            <view class="reagent-info">
              <view class="reagent-name">{{r.name}}</view>
              <view class="reagent-unit" wx:if="{{r.unit}}">单位：{{r.unit}}</view>
            </view>
          </view>
          <view class="reagent-right">
            <input
              class="amount-input"
              type="text"
              placeholder="用量"
              data-id="{{r.id}}"
              bindinput="onReagentAmountInput"
            />
          </view>
        </view>
      </checkbox-group>
    </scroll-view>
    <view class="hint-text" style="margin-top: 10rpx;">
      提示：勾选试剂并填写用量后，系统会自动填入上方“使用试剂和用量（文本）”，你也可以再手动调整。
    </view>
  </view>
  <view class="modal-footer">
    <button class="modal-btn cancel" bindtap="closeReagentSelector">取消</button>
    <button class="modal-btn confirm" bindtap="confirmReagentSelection">确定</button>
  </view>
</view>